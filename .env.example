# Household.Api environment example
# Copy to .env for local development or set these variables in CasaOS/Docker.
# Do not commit real secrets.

# Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
DATABASE_PATH=/data/household.db

JWT_SECRET_KEY=change-me-32-plus-chars
JWT_ISSUER=Household.Api
JWT_AUDIENCE=Household.Client
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

CORS_ALLOWED_ORIGINS=https://household.example.local,http://localhost:5173

HOUSEHOLD_PUBLIC_URL=https://household.example.local
HOUSEHOLD_API_PUBLIC_URL=https://household-api.example.local
HOUSEHOLD_CLIENT_ID=household
DATA_PROTECTION_KEYS_PATH=/data/keys
GITHUB_ACTIONS_POLL_SECONDS=60
GITHUB_ACTIONS_CONCURRENCY=4

# Anticipated provider routes. Override if a provider deployment differs.
WARCRAFT_STATUS_PATH_TEMPLATE=/api/integrations/household/v1/trackings/{id}/status
POKEMON_DOWNLOAD_PATH_TEMPLATE=/api/integrations/household/v1/pokemon/{id}/download

# Initial admin user
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=admin@local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin-password
DEMO_DATA_ENABLED=false

# Feature flags
FEATURE_APPS_LAUNCHER=true
FEATURE_INTEGRATION_SETTINGS=true
FEATURE_DOCKER_STATUS=false
FEATURE_DOCKER_ADMIN_ACTIONS=false
FEATURE_JELLYFIN_REMOTE_CONTROL=false
FEATURE_WGEASY_WRITE_ACTIONS=false

# Internal apps
DOIT_BASE_URL=http://doit-api:8080
DOIT_OPEN_URL=https://doit.example.local

GAMESDATABASE_BASE_URL=http://gamesdatabase-api:8080
GAMESDATABASE_OPEN_URL=https://games.example.local

JELLYWATCH_BASE_URL=http://jellywatch-api:8080
JELLYWATCH_OPEN_URL=https://jellywatch.example.local

BEASTVAULT_BASE_URL=http://beastvault-api:8080
BEASTVAULT_OPEN_URL=https://beastvault.example.local

WARCRAFTARCHIVE_BASE_URL=http://warcraftarchive-api:8080
WARCRAFTARCHIVE_OPEN_URL=https://warcraft.example.local

# Jellyfin URLs/API key and the GitHub read-only PAT are configured by an
# administrator through Household's write-only API and encrypted in the database.

SEERR_BASE_URL=http://192.168.0.32:5056
SEERR_OPEN_URL=https://seerr.davidhormigafonso.work
SEERR_API_KEY=

# Sonarr / Radarr
SONARR_BASE_URL=http://sonarr:8989
SONARR_OPEN_URL=https://sonarr.example.local
SONARR_API_KEY=

RADARR_BASE_URL=http://radarr:7878
RADARR_OPEN_URL=https://radarr.example.local
RADARR_API_KEY=

# qBittorrent
QBIT_BASE_URL=http://qbittorrent:8080
QBIT_OPEN_URL=https://qbit.example.local
QBIT_USERNAME=
QBIT_PASSWORD=

# WireGuard Easy
WGEASY_BASE_URL=http://wg-easy:51821
WGEASY_OPEN_URL=https://vpn.example.local
WGEASY_USERNAME=
WGEASY_PASSWORD=
WGEASY_ENABLE_WRITE_ACTIONS=false

# Docker status
DOCKER_MODE=disabled
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_COMPOSE_BIN=docker
DOCKER_COMMAND_TIMEOUT_SECONDS=120
DOCKER_LOG_TAIL_LINES=300
DOCKER_ALLOWED_COMPOSE_PATHS=

APP_LAUNCHER_CONFIG_PATH=/data/app-launcher.json

# Optional meal type time ranges
#MEAL_BREAKFAST_START=07:00
#MEAL_BREAKFAST_END=10:30
#MEAL_MORNING_SNACK_START=10:30
#MEAL_MORNING_SNACK_END=12:00
#MEAL_LUNCH_START=12:00
#MEAL_LUNCH_END=15:30
#MEAL_AFTERNOON_SNACK_START=15:30
#MEAL_AFTERNOON_SNACK_END=20:00
#MEAL_DINNER_START=20:00
#MEAL_DINNER_END=23:59
