{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },

  "DatabaseSettings": {
    "DatabasePath": "../household-dev.db",
    "EnableSensitiveDataLogging": false
  },

  "JwtSettings": {
    "SecretKey": "DevOnlySecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "Household.Api.Dev",
    "Audience": "Household.Client.Dev",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },

  "HouseholdConnectionSettings": {
    "ClientId": "household",
    "DataProtectionKeysPath": "../keys"
  },

  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },

  "SeedSettings": {
    "AdminEnabled": false,
    "AdminEmail": "admin@local",
    "AdminUsername": "admin",
    "AdminPassword": "",
    "DemoDataEnabled": false
  }
}
