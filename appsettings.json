{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DatabaseSettings": {
    "DatabasePath": "/data/household.db",
    "EnableSensitiveDataLogging": false
  },

  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "Household.Api",
    "Audience": "Household.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },

  "HouseholdConnectionSettings": {
    "ClientId": "household",
    "DataProtectionKeysPath": "/data/keys"
  },

  "CorsSettings": {
    "AllowedOrigins": []
  },

  "SeedSettings": {
    "AdminEnabled": false,
    "AdminEmail": "admin@local",
    "AdminUsername": "admin",
    "AdminPassword": "",
    "DemoDataEnabled": false
  },

  "MealTypeSettings": {
    "BreakfastStart": "07:00",
    "BreakfastEnd": "10:30",
    "MorningSnackStart": "10:30",
    "MorningSnackEnd": "12:00",
    "LunchStart": "12:00",
    "LunchEnd": "15:30",
    "AfternoonSnackStart": "15:30",
    "AfternoonSnackEnd": "20:00",
    "DinnerStart": "20:00",
    "DinnerEnd": "23:59"
  },

  "ExternalIntegrationSettings": {
    "GitHubPollSeconds": 60,
    "GitHubConcurrency": 4,
    "ProviderAssetMaxBytes": 8388608,
    "WarcraftStatusPathTemplate": "/api/integrations/household/v1/trackings/{id}/status",
    "PokemonDownloadPathTemplate": "/api/integrations/household/v1/pokemon/{id}/download"
  },

  "CasaOsUpdateSettings": {
    "BackupRoot": "/data/compose-backups",
    "RequestTimeoutSeconds": 15,
    "MaxYamlBytes": 2097152,
    "MaxJsonBytes": 262144
  }
}
